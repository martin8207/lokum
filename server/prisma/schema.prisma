generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String  @id
  nameBg    String
  nameEn    String
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  subcategories Subcategory[]
  products      Product[]
}

model Subcategory {
  id String @id

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  nameBg String
  nameEn String

  sortOrder Int     @default(0)
  active    Boolean @default(true)

  products Product[]
}

model Product {
  id String @id

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  subcategoryId String
  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id])

  brand   String?
  variant String?

  nameBg String
  nameEn String?

  descriptionBg String?
  descriptionEn String?

  priceEur Decimal?

  quantity Float?
  unit     String?

  image String?

  featured      Boolean @default(false)
  isNew         Boolean @default(false)
  isRecommended Boolean @default(false)
  available     Boolean @default(true)

  tags      String[] @default([])
  allergens String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]
}

enum PaymentMethod {
  CASH
  CARD
}

/// Сметката на една маса - отваря се автоматично при първата поръчка,
/// затваря се при фактуриране. Групира множество Order записи, защото
/// клиентите обикновено правят няколко кръга поръчки на едно седене -
/// "Фактуриран" покрива цялата сесия, не последната поръчка.
model TableSession {
  id          String    @id @default(uuid())
  tableNumber Int

  openedAt      DateTime       @default(now())
  invoicedAt    DateTime?
  paymentMethod PaymentMethod?

  // Клиентът поиска сметката директно от масата (виж
  // customerOrders.js:/request-bill) - персоналът вижда искането на
  // таблото/детайла и го затваря със стандартния /invoice поток, след
  // като всичко мине през КА. Не затваря сесията само по себе си.
  billRequestedAt        DateTime?
  requestedPaymentMethod PaymentMethod?

  orders Order[]

  // Само една активна (нефактурирана) сесия на маса в даден момент -
  // на ниво приложение се проверява преди отваряне на нова.
  @@index([tableNumber, invoicedAt])
}

/// Един "кръг" поръчки, подаден наведнъж от бележника. servedAt/cancelledAt
/// са на ниво поръчка (цялата се сервира или отказва наведнъж), но
/// потвърждението в касовия апарат е на ниво отделна бройка - виж OrderItem.
model Order {
  id             String       @id @default(uuid())
  tableSessionId String
  tableSession   TableSession @relation(fields: [tableSessionId], references: [id])

  submittedAt DateTime  @default(now())
  servedAt    DateTime?
  cancelledAt DateTime?

  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@index([tableSessionId])
}

/// Една бройка от артикул - НЕ ред с количество. "2x Стела" при подаване на
/// поръчката създава 2 отделни записа, защото на практика бройките от едно
/// и също количество могат да имат различна съдба (1 налята в КА, другата
/// свършила и изтрита) - виж lokum-staff-search-demo.html / разговора за
/// легендата със зелени/червени маркери.
model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])

  // Снимка на цената в момента на поръчката - продуктовите цени могат да
  // се сменят по-късно, сметката на масата не бива да "мърда" ретроактивно.
  priceEur Decimal

  kaConfirmedAt DateTime?
  removedAt     DateTime?

  createdAt DateTime @default(now())

  @@index([orderId])
}

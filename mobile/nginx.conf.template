# Логваме и двете поотделно (не сливаме с map) - за да е ясно кое точно е
# видяла nginx като директен TCP peer ($remote_addr) срещу какво Funnel/
# relay-ят твърди, че е оригиналният клиент (X-Forwarded-For), вместо да
# гадаем кое от двете влиза в един слят резултат.
log_format lokum_access '$remote_addr xff=$http_x_forwarded_for - [$time_local] "$request" $status $body_bytes_sent "$http_user_agent"';

# Двете имена по-долу са ВИНАГИ дефинирани тук, независимо кой образ (web
# vs web-v2) чете файла - всички lokum-server* контейнери седят в една и
# съща Docker мрежа (виж docker-compose.yml), значи имената им се
# resolve-ват от всеки от двата nginx-а, дори тук да се ползва само едното.
# api_production е реалният round-robin+failover между двете production
# копия на бекенда - nginx маркира паднало upstream за 10с (default
# max_fails/fail_timeout) и праща следващите заявки към другото, без
# клиентът изобщо да усети.
upstream api_production {
    server lokum-server:3000;
    server lokum-server-2:3000;
}
upstream api_test {
    server lokum-server-v2:3000;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Отделен файл (не access.log) - стоковият nginx:alpine image симлинква
    # access.log към /dev/stdout, а Docker копира тази символна връзка в
    # новия volume при първо mount-ване, което пречи на реален persist.
    access_log /var/log/nginx/lokum-access.log lokum_access;

    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/wasm
        image/svg+xml
        font/ttf
        font/otf;

    # index.html/manifest/version.json - винаги revalidate, за да получат
    # клиентите новия build веднага след деплой (не чакат стар кеш да изтече).
    location ~* \.(?:html|json)$ {
        add_header Cache-Control "no-cache";
    }

    location = /flutter_bootstrap.js {
        add_header Cache-Control "no-cache";
    }

    location = /flutter_service_worker.js {
        add_header Cache-Control "no-cache";
    }

    # Основният app bundle - сменя се при всеки деплой (в момента - по
    # няколко пъти на ден). 24ч кеш означаваше клиентът да не вижда НИКАКВА
    # промяна в кода до изтичане на деня или ръчно чистене на кеша. no-cache
    # = винаги бърз conditional GET, но веднага вижда нов build.
    location = /main.dart.js {
        add_header Cache-Control "no-cache";
    }

    # CanvasKit engine-ът - обвързан с Flutter SDK версията, не се "замества
    # под същото име" в реалния workflow, безопасно е да се кешира дълго.
    location ^~ /canvaskit/ {
        add_header Cache-Control "public, max-age=2592000, immutable";
    }

    # Бъндълнати шрифтове (Nunito/Unbounded) - същата логика, статични per build.
    location ~* \.(?:woff2|ttf|otf)$ {
        add_header Cache-Control "public, max-age=2592000, immutable";
    }

    # Снимки (лога, продукти, ивенти, campaign/background) - тук `immutable`
    # е грешен избор: реалният workflow е "замести файла под същото име"
    # (продукт/ивент/фон снимка), не cache-busting с нов filename. С
    # immutable браузърът никога не проверява отново до 30 дни, дори
    # съдържанието на сървъра да се е сменило - показва старата снимка.
    # no-cache = винаги revalidate (бърз conditional GET), но веднага вижда
    # промяна, щом файлът реално се смени.
    location ~* \.(?:png|jpg|jpeg|webp|gif|ico)$ {
        add_header Cache-Control "no-cache";
    }

    # Проксира API заявките към upstream групата, зададена от API_BACKEND
    # (env var, виж docker-compose.yml) - "api_production" (lokum-server +
    # lokum-server-2, round-robin) за lokum-web, "api_test" (lokum-server-v2,
    # само един) за lokum-web-v2. Този файл е .template и се envsubst-ва
    # автоматично от nginx:alpine entrypoint-а при старт (виж Dockerfile.web)
    # - НЕ добавяй тук нов $VAR, който не е реална env променлива, иначе ще
    # се опита да го замести и ще излезе празно.
    #
    # ВАЖНО: Tailscale Funnel сочи директно към порта на тази nginx (8080 за
    # production), НЕ през Caddy - Caddy въобще не участва в реалния трафик
    # (виж root Caddyfile/docker-compose.yml коментарите за историята). Затова
    # тук трябва ВИНАГИ коректната upstream група за средата, не "дефолт към
    # test, защото production мине другаде" - това предположение излезе
    # грешно и прати реален клиентски/персонал трафик към test базата.
    location /api/ {
        proxy_pass http://${API_BACKEND}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # SPA fallback - само за route-подобни пътища (без разширение, напр.
    # бъдещ /events/greesh-live). Липсващи статични файлове (.map, .txt,
    # снимки и т.н.) трябва да връщат истинска 404, а не index.html -
    # иначе браузър/SEO инструменти получават HTML там, където очакват
    # JSON/plain text (точно това чупеше source map fetch-а и robots.txt).
    location / {
        try_files $uri $uri/ @fallback;
    }

    location @fallback {
        if ($uri ~ "\.") {
            return 404;
        }
        rewrite ^ /index.html last;
    }
}

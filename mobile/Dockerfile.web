# --- Stage 1: build Flutter web ---
FROM ghcr.io/cirruslabs/flutter:stable AS build

WORKDIR /app

COPY . .

RUN flutter pub get
# --no-tree-shake-icons: release build-ът иначе маха "неизползвани" MaterialIcons
# glyph-ове по статичен анализ, който понякога пропуска реално използвани икони
# (напр. Icons.settings, Icons.visibility_outlined/visibility_off_outlined) -
# бутонът пак работи, но иконата е невидима. Разходът е няколко KB по-голям
# шрифт, компромисът си струва за коректни икони навсякъде.
RUN flutter build web --release --source-maps --no-tree-shake-icons

# --- Stage 2: сервиране на статичните файлове с nginx ---
FROM nginx:alpine

# Alpine е минимален - без tzdata пакета TZ env варът долу не важи на нищо
# (няма /usr/share/zoneinfo файлове). Логовете да са в местно време
# (Europe/Sofia), не UTC, за по-лесно четене.
RUN apk add --no-cache tzdata
ENV TZ=Europe/Sofia

COPY --from=build /app/build/web /usr/share/nginx/html
# .template + /etc/nginx/templates/ - вграденият envsubst механизъм на
# nginx:alpine (docker-entrypoint.d скриптовете) го обработва автоматично
# при старт, замествайки ${API_BACKEND} (реална env променлива, виж
# docker-compose.yml) в /etc/nginx/conf.d/default.conf. Позволява едно и
# също build-нато изображение да сочи към различен бекенд според службата
# (lokum-server за production, lokum-server-v2 за test), без отделни nginx.conf файлове.
COPY nginx.conf.template /etc/nginx/templates/default.conf.template

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]

# Копирай този файл като ".env" в root на проекта и попълни истинските стойности.

# DuckDNS токен (за duckdns контейнера) - вземи го от duckdns.org след логин,
# полето "token" на началната страница.
DUCKDNS_TOKEN=

# PostgreSQL credentials - ползват се и от "postgres" контейнера директно, и
# автоматично се вграждат в DATABASE_URL за lokum-server (виж docker-compose.yml).
# Сложи собствени стойности, не оставяй "lokum"/"lokum123" placeholder-ите.
POSTGRES_DB=lokum
POSTGRES_USER=lokum
POSTGRES_PASSWORD=

# Текущ публичен адрес на апа (за scripts/generate-qr.js). Update-вай при
# смяна на домейн (напр. нов Tailscale Funnel адрес) и пусни "npm run generate-qr".
PUBLIC_APP_URL=

# Логин на бележника на персонала И на кухнята - споделена парола за всеки
# от двата екипа (не индивидуален login). Ползва се и от lokum-server, и от
# lokum-server-v2 (един и същ .env за целия compose проект). Генерирай:
#   JWT_SECRET:             node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   STAFF_PASSWORD_HASH:    docker compose run --rm lokum-server node -e "console.log(require('bcryptjs').hashSync('парола-на-персонала', 10))"
#   KITCHEN_PASSWORD_HASH:  docker compose run --rm lokum-server node -e "console.log(require('bcryptjs').hashSync('парола-на-кухнята', 10))"
# ВАЖНО: hash-овете съдържат "$" знаци - екранирай ги като "$$" тук, иначе
# Docker Compose ги гълта при четене на .env (напр. "$2a$10$..." -> "$$2a$$10$$...").
JWT_SECRET=
STAFF_PASSWORD_HASH=
KITCHEN_PASSWORD_HASH=

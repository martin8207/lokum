# Копирай този файл като ".env" в root на проекта и попълни истинските стойности.

# DuckDNS токен (за duckdns контейнера) - вземи го от duckdns.org след логин,
# полето "token" на началната страница.
DUCKDNS_TOKEN=

# PostgreSQL credentials - ползват се и от "postgres" контейнера директно, и
# автоматично се вграждат в DATABASE_URL за lokum-server (виж docker-compose.yml).
# Сложи собствени стойности, не оставяй "lokum"/"lokum123" placeholder-ите.
POSTGRES_DB=lokum
POSTGRES_USER=lokum
POSTGRES_PASSWORD=
